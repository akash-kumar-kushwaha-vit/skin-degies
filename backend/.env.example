# ============================================================
# SkinDegies Backend — Environment Variables
# ============================================================
# Copy to .env and fill in values. Never commit .env.

# Server
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-app.vercel.app
API_BASE_URL=https://your-backend.onrender.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skindegies?retryWrites=true&w=majority

# JWT — generate strong secrets: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_ACCESS_SECRET=your-very-long-random-access-secret-here
JWT_REFRESH_SECRET=your-very-long-random-refresh-secret-here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AI Service (FastAPI on Railway)
AI_SERVICE_URL=https://your-ai-service.railway.app

# LLM Configuration
# Switch provider without code changes: gemini | openai | auto
LLM_PROVIDER=openai

# Gemini model (kept for compatibility; auto-fallback will route to OpenAI if Gemini is unavailable)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (preferred local fallback because Gemini model availability can change)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Admin seed
ADMIN_EMAIL=admin@skindegies.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Logging
LOG_LEVEL=info
