# SkinDegies AI Service — Hugging Face Spaces Docker Deployment
# ===============================================================
# Optimized for Hugging Face Paid Docker Spaces
# Port: 7860 (HF standard)
# Memory: Requires 4GB+ RAM for model loading

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY . .

# Create required directories
RUN mkdir -p checkpoints logs

# HF Spaces runs as root, but good practice to set permissions
RUN chmod -R 755 /app

# Hugging Face Spaces exposes on port 7860
EXPOSE 7860

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:7860/api/v1/health || exit 1

# Run with HF PORT environment variable (defaults to 7860)
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-7860} --workers 1 --log-level info"]
