# ============================================================
# SkinDegies AI Service — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false
ENVIRONMENT=production

# Model
# Absolute or relative path to the model checkpoint.
# Default: checkpoints/best_model.pth (relative to ai-model/)
MODEL_PATH=checkpoints/best_model.pth
MODEL_ARCH=efficientnet_v2_s

# Inference
TOP_K=3
CONFIDENCE_THRESHOLD=0.0

# CORS
# Comma-separated list of allowed origins.
# Use "*" for development. Set specific domains for production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ai_service.log
